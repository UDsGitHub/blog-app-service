generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Article {
  id String @db.Uuid @default(dbgenerated("gen_random_uuid()")) @id
  title String @db.VarChar(150)
  slug String @db.VarChar(255) @unique
  body String @db.Text
  status ArticleStatus @default(DRAFT)
  excerpt String? @db.VarChar(300) @default("")
  searchVector Unsupported("tsvector")? @map("search_vector")
  createdAt DateTime @default(now()) @db.Timestamptz @map("created_at")
  updatedAt DateTime? @db.Timestamptz @map("updated_at")
  publishedAt DateTime? @db.Timestamptz @map("published_at")
  
  slugHistory ArticleSlugHistory[]
  @@index([searchVector], map: "idx_article_search_vector", type: Gin)
  @@map("article")
}

model ArticleSlugHistory {
  articleId String @db.Uuid @map("article_id")
  slug String @db.VarChar(255) @unique
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id(fields: [articleId, slug])
  @@map("article_slug_history")
}

